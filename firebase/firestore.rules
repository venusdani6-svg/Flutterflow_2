rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tier-5 hardening (2026-08-03, plan item 19): affiliator/referred-cast
    // reward records, has `affiliator_uid`/`referred_uid` on every doc
    // (confirmed live via schema.md + admin.ts/affiliate.ts/stripe-payments.ts/
    // auth.ts, all Admin-SDK-only writers, no client-direct-write path found).
    // Create is Cloud-Functions-only; read is owner-or-admin, same pattern as
    // the 2026-07-31 Tier-4 pass.
    match /affiliate_rewards/{document} {
      allow create: if false;
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.affiliator_uid == request.auth.uid
            || resource.data.referred_uid == request.auth.uid));
      allow write: if false;
      allow delete: if false;
    }

    // Tier-5 hardening (2026-08-03, plan item 19): chat room metadata has a
    // `participants` array (confirmed schema.md + reservations.ts, which
    // creates every room via Admin SDK) - currently exposes who's chatting
    // with whom to anyone unauthenticated. Read is participant-or-admin.
    // Note: the `chat_rooms/{room_id}/messages` subcollection is NOT
    // governed by this rule at all (Firestore rules aren't recursive) - it
    // has no rule of its own either; flagged as a separate follow-up, not
    // expanded into this pass.
    match /chat_rooms/{document} {
      allow create: if false;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.participants.hasAny([request.auth.uid]));
      allow write: if false;
      allow delete: if false;
    }

    // Phase 6 (2026-08-11): closes the gap the 2026-08-03 comment above
    // explicitly flagged and deliberately left open ("NOT governed by this
    // rule at all... has no rule of its own either"). Content-based via a
    // `get()` on the parent `chat_rooms` doc, same technique `isAdmin()`
    // already uses on `users/{uid}` - provably satisfiable for exactly the
    // room's own participants, denied for everyone else. Write stays
    // Cloud-Functions-only (`sendChatMessage`, reservations.ts) so the
    // posting-lock (`chat_rooms.active`) and `last_message`/
    // `last_message_time` mirroring can be enforced atomically server-side;
    // a client-direct write here would bypass both.
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants.hasAny([request.auth.uid]));
      allow create, update, delete: if false;
    }

    // Tier-5 hardening (2026-08-03, plan item 19): confirmed a REAL,
    // actively-used collection (6 operations in admin.ts - list/get/count/
    // update/create/delete) distinct from the `cocomise` match block below,
    // which protects nothing - "cocomise" is only ever used as an
    // audit-log action/targetType string label in admin.ts, never an actual
    // Firestore collection path. Guest-facing (ココ店, gated by
    // `features_enabled.cocoten`), so read stays public like `banners`/
    // `prefectures`; only create/update/delete are admin-gated.
    match /cocoten_shops/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tier-5 hardening (2026-08-03, plan item 19): global app config
    // (`/system_config/settings` - tax rate, thresholds, feature flags).
    // Every confirmed reader in this backend is server-side (admin.ts,
    // config.ts, both via Admin SDK, which bypasses these rules anyway) -
    // no evidence found of a legitimate client-side read need, so tightened
    // to admin-only like `ledger`/`stripe_logs` rather than assumed public.
    // Mirrors the already-existing `system_settings` collection's pattern.
    match /system_config/{document} {
      allow read, write: if isAdmin();
    }

    // Tier-4 hardening (2026-07-31): financial ledger, has a `user_id`
    // field on every doc (confirmed live) - Cloud Functions (Admin SDK,
    // bypasses these rules entirely) are the only legitimate writer, so
    // client create is blocked outright; read is owner-or-admin, matching
    // the same pattern already used below for withdrawal_applications/
    // kyc_reviews.
    match /ledger/{document} {
      allow create: if false;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }

    // Tier-4 hardening (2026-07-31): pure internal Stripe webhook log, no
    // user-identifying field at all - written exclusively by
    // stripe-webhooks.ts via Admin SDK. No legitimate client read or
    // write of any kind.
    match /stripe_logs/{document} {
      allow create: if false;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // Tier-4 hardening (2026-07-31): cast/staff payout requests, has a
    // `user_id` field on every doc (confirmed live via admin.ts's own
    // adminGetPayoutRequests query and direct Firestore samples). Create
    // is limited to the authenticated user requesting their own payout;
    // read is owner-or-admin, same pattern as withdrawal_applications/
    // kyc_reviews below. Status changes (approve/hold/reject) remain
    // Cloud-Functions-only via the existing `write: false`.
    match /payout_requests/{document} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
      allow delete: if false;
    }


    // ── Helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    // FIX (confirmed live bug, found during audit): this checked
    // `data.role_admin`, a field that is never written anywhere in this
    // project (confirmed against schemas.dart's field definition and
    // auth.ts's actual writer, both of which use `role`) - `role_admin` is
    // a field name from a different, sister project's own schema that
    // leaked into this ruleset via the shared reference tree. Every
    // isAdmin()-gated rule in this file (system_config, stripe_logs,
    // audit_logs, the admin-OR-owner fallback on ledger/reservations/
    // chat_rooms/etc.) silently evaluated isAdmin() as permanently false
    // for every user, including real admins - currently unobserved only
    // because no admin-panel UI exists yet to exercise a direct-client
    // read gated by this function (every admin Cloud Function uses the
    // Admin SDK, which bypasses rules entirely).
    function isAdmin() {
      return userDocExists()
        && get(userDocPath()).data.role == 'admin';
    }

    function hasOnlyKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // ── users ────────────────────────────────────────────────────────────

    match /users/{document} {
      allow read: if request.auth.uid == document;
      // FIX (PROJECT_KNOWLEDGE.md §70, CRITICAL — comprehensive project-wide
      // review): `allow write: if request.auth.uid == document` had NO
      // field-level restriction — any signed-in user could write ANY field
      // on their own doc directly via the client SDK, including
      // server-authoritative fields multiple Cloud Functions trust as if
      // only they could have written them:
      //   - `role`/`role_admin`/`roleAdmin` — the ENTIRE admin gate
      //     (verifyAdmin/verifyAdminV1, admin.ts:15-54, read these straight
      //     off this doc with no Firebase custom-claims check anywhere) —
      //     a full admin-takeover primitive with one client-side write.
      //   - `individual_rate` — feeds a real stripe.transfers.create()
      //     amount in recordCastRewardsAndProcessOthers/
      //     captureAuthorizedExtensions (stripe-payments.ts); its only
      //     other writer (onUserCreated) never touches it again after
      //     account creation, so this field's real-world writer WAS this
      //     rule — direct theft of platform Stripe balance.
      //   - `affiliate_rate` — bypasses adminUpdateAffiliateRate's
      //     0.05-0.30 range validation and audit-log trail entirely,
      //     inflating a real monthly Stripe Transfer.
      //   - `approval_status`/`kyc_status`/`is_verified` — the entire
      //     KYC/approval trust boundary (reservations.ts, work-posts.ts,
      //     getDiscoveryCasts, affiliate.ts's mutual-approval rule all
      //     trust this field) — self-approve as a "verified cast" with
      //     zero actual review.
      //   - `is_frozen` (self-unfreeze a banned account) /
      //     `logical_debt` (erase owed debt to unlock withdrawal/payout).
      //   - `stripe_account_id`/`stripe_customer_id`, `referred_by_uid`
      //     (defeats the documented "no retroactive referral entry" rule).
      // Confirmed via a full grep of every direct client Firestore access
      // to `users` in dsl/edit.dart: all 6 call sites are `.get()` reads,
      // never a write — every legitimate mutation already goes through a
      // Cloud Function (updateProfile/completeOnboarding/submitKYC/
      // blockUser/unblockUser/adminApproveKYC/etc.), all of which use the
      // Admin SDK and therefore bypass this rule entirely regardless of
      // what it says. `onUserCreated` (the auth.user().onCreate trigger
      // that creates this doc) is also Admin-SDK. So denying ALL direct
      // client writes here has zero impact on any real feature — simpler
      // and strictly safer than enumerating a "safe" field allowlist and
      // risking missing one.
      allow write: if false;
    }

    // Phase 6 (2026-08-11): `users/{uid}/notifications` subcollection - had
    // NO rule of its own (Firestore rules aren't recursive, so the parent
    // `users/{document}` block above doesn't cover it - confirmed absent
    // from the live ruleset, same "no rule = deny-all" gap class as the
    // `chat_rooms/{id}/messages` one above, not assumed). Written
    // exclusively by Cloud Functions across 17 call sites (auth.ts,
    // admin.ts, affiliate.ts, reservations.ts, stripe-payments.ts,
    // stripe-webhooks.ts, all Admin SDK - confirmed via grep, no client
    // create path exists), so create/delete stay blocked. Read is owner-
    // or-admin. Update is owner-only and restricted to flipping `read`
    // ONLY (via `diff().affectedKeys()`) - a user can mark their own
    // notification read, never rewrite its title/body/type/data.
    match /users/{userId}/notifications/{notifId} {
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── favorites (§3.6.6) ──────────────────────────────────────────────
    // Deny all direct client access — mirrors this ruleset's own general
    // convention (own comments above: reservation-status transitions,
    // wallet/ledger, etc. all Cloud-Functions-only). `addFavorite`/
    // `removeFavorite`/`getFavoriteCasts` (auth.ts) are the only path,
    // Admin SDK. Not strictly REQUIRED here the way it is for money/status
    // fields (a favorite is low-stakes), but kept consistent with this
    // project's established choice for `blocked_users`-adjacent data over
    // introducing the one exception — same reasoning `schedule_slots`'s own
    // doc comment gives for why even its permissive rule still isn't relied
    // on by any real client call.
    match /users/{userId}/favorites/{castId} {
      allow read, write: if false;
    }

    // ── invitions ────────────────────────────────────────────────────────
    // FIX (comprehensive project-wide review round 2): tightened to
    // deny-all. The 2026-07-31 Tier-4 pass left this open pending
    // confirmation that no live client flow depends on it — this review
    // round independently re-confirmed zero `dsl/edit.dart` references and
    // zero Cloud Function references anywhere in the backend, the same
    // result as every prior audit. An unconditionally open create/read on
    // a collection nothing in this codebase ever writes or reads is pure
    // attack surface (arbitrary-document spam/storage cost at minimum)
    // with no offsetting functionality to preserve, so there is no longer
    // a reason to leave it open.
    match /invitions/{document} {
      allow read, write: if false;
    }

    // ── Admin-managed collections ────────────────────────────────────────

    // Tier-5 hardening (2026-08-03, plan item 19): highest-risk of the 6 -
    // `guest_id`/`cast_ids`/`staff_ids`, PaymentIntent IDs, amounts, and
    // real addresses (confirmed schema.md), previously readable by anyone
    // unauthenticated. `createReservation` (reservations.ts) is a Cloud
    // Function (`onCall`) - no legitimate client-direct-create path exists,
    // so create is blocked outright. Read is guest/cast/staff-on-this-
    // reservation-or-admin.
    match /reservations/{document} {
      allow create: if false;
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.guest_id == request.auth.uid
            || resource.data.cast_ids.hasAny([request.auth.uid])
            || resource.data.staff_ids.hasAny([request.auth.uid])));
      allow write: if false;
      allow delete: if false;
    }

    // FIX (comprehensive project-wide review, 2026-08-17): removed rule
    // blocks for `payment_ledger`, `withdrawal_applications`, `kyc_reviews`
    // (this spot), and `affiliates`/`cocomise`/`job_board_posts`/
    // `system_settings`/`prefectures` (below) - confirmed zero readers or
    // writers anywhere in this repo (backend Cloud Functions, dsl/edit.dart,
    // generated_code/, and not declared as a collection in
    // lib/flutterflow_project/schemas.dart). These were dead surface area:
    // rule blocks with no real data behind them, several of which (e.g.
    // withdrawal_applications/kyc_reviews) even granted an authenticated
    // client a direct create path into a collection nothing ever reads,
    // which is more attack surface than the app actually needs. If any of
    // these are genuinely planned features, re-add the rule (and, per
    // schema.md, the collection) when the real read/write path is built.

    // Tier-4 hardening (2026-07-31): reports are filed by one user about
    // another (reporter_id/reported_id, both confirmed live) and carry an
    // admin_note field not meant for either party to see - kept
    // admin-only for read (not reporter-readable) rather than exposing
    // report status/notes to the filer, at least until a dedicated "my
    // reports" UI is scoped as its own feature. Create is limited to the
    // authenticated reporter filing on their own behalf.
    match /reports/{document} {
      allow create: if isSignedIn()
        && request.resource.data.reporter_id == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // Phase 11 slice 3 (2026-08-12): `inquiries` (general contact-the-
    // operator form, distinct from `reports` above which is specifically
    // for reporting another user) - same shape as `reports`: create is
    // limited to the authenticated submitter filing on their own behalf,
    // read is admin-only.
    match /inquiries/{document} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // Phase 7 (2026-08-11): had NO rule at all (default deny-all, same
    // "no rule = deny-all" gap class as `chat_rooms/{id}/messages` and
    // `users/{uid}/notifications` found earlier this session) — confirmed
    // via a direct read of this file, not assumed. Reviews are guest-
    // written star-rating/comment records meant to be publicly browsable on
    // a cast's own profile (§3.7.13, "star-rating/review viewing, read-only,
    // from guest") — read stays open, matching the already-established
    // `cocoten_shops`/`banners`/`prefectures` pattern for guest-facing
    // browsable content, rather than adding a Cloud Function purely to
    // route around a rule that can just be made correctly public. Create is
    // Cloud-Functions-only (`submitReview`, reservations.ts, Admin SDK) —
    // no legitimate client-direct-create path exists, matching `reports`.
    match /reviews/{document} {
      allow read: if true;
      allow create: if false;
      allow write: if false;
      allow delete: if false;
    }

    // Added during audit (2026-08-12): `work_posts` is a real, actively
    // read/written collection (work-posts.ts, admin.ts) that had NO rule of
    // its own at all - the same "no rule = deny-all" gap class already
    // found and fixed 3 times before this session (chat_rooms/messages,
    // users/notifications, reviews). Every current caller goes through
    // Cloud Functions (Admin SDK, bypasses this rule), so this was not
    // actively broken - added proactively so a future direct-client read
    // (poster/applicant viewing their own posts) works correctly instead
    // of silently returning nothing. Create/write stay Cloud-Functions-only
    // (status transitions, applicant list mutation) since those need
    // server-side validation this ruleset can't replicate.
    match /work_posts/{document} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.poster_id == request.auth.uid
            || resource.data.applicants.hasAny([request.auth.uid])));
      allow create, write: if false;
      allow delete: if false;
    }

    // Added during audit (2026-08-12): `debt_history` (reservations.ts,
    // stripe-payments.ts) had no rule of its own - same gap class as
    // `work_posts` above. Owner-or-admin read, matching the `ledger`
    // pattern this collection is conceptually a sub-ledger of.
    match /debt_history/{document} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create, write: if false;
      allow delete: if false;
    }

    // Added during audit (2026-08-12): `pair_history` (stripe-webhooks.ts,
    // the 30-minute-rule dedupe ledger) had no rule of its own - same gap
    // class as above. Purely internal bookkeeping (no dedicated UI concept
    // for either party to view their own pairing history), so admin-only
    // read matches `stripe_logs`'s pattern rather than an owner-read rule.
    match /pair_history/{document} {
      allow read: if isAdmin();
      allow create, write: if false;
      allow delete: if false;
    }

    // Added during comprehensive review (2026-08-12): `reservations/{resId}
    // /extensions` (subcollection, written by createExtensionPayment/
    // captureAuthorizedExtensions, read by adminGetReservationExtras) had
    // NO rule of its own — same "no rule = deny-all" gap class as its 3
    // siblings above (debt_history/pair_history/work_posts, fixed the same
    // day but this one was missed in that pass). Currently harmless in
    // practice (confirmed zero client-side access anywhere in dsl/edit.dart
    // — every touch point is Admin SDK) but closing the gap for
    // consistency and to remove the latent trap for a future client-side
    // read.
    match /reservations/{resId}/extensions/{extId} {
      allow read, write: if isAdmin();
    }

    // Tier-5 hardening (2026-08-03, plan item 19): genuinely public
    // promotional content (title/image_url/link_url/page/display_order) -
    // read stays open, matching the already-proven `prefectures` pattern.
    // Only create was ever wrong (anyone unauthenticated could inject
    // banner documents) - tightened to admin-only, update/delete added
    // (previously blocked outright by `write: false`, which the live
    // バナー広告管理 CRUD needs).
    match /banners/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tier-5 hardening (2026-08-03, plan item 19): added, not tightened -
    // this collection had NO rule at all (confirmed absent from the live
    // deployed ruleset, re-checked via unauthenticated REST call before
    // assuming), which defaults to deny-all in Firestore. Confirmed real
    // and in schema (`/schedule_slots/{slot_id}`, `cast_id` field) via
    // schema.md + one live backend reference (stripe-payments.ts, the
    // 30分ルール check). No admin-dashboard UI touches this collection
    // today - this rule exists for the (out-of-this-repo) mobile app's
    // "cast can only update their own ScheduleSlots" requirement (§17),
    // not for anything this repo itself exercises.
    match /schedule_slots/{document} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.cast_id == request.auth.uid);
      // FIX (comprehensive review): the `cast_id` FIELD check alone let any
      // signed-in user create a document at another cast's own resolution
      // ID (`{castId}_{slotStartMs}`, per schedule.ts's slotDocId()) while
      // setting `cast_id` to their own uid - a doc-ID collision, not a
      // field-value forgery. Every backend consumer that locks/checks
      // availability (schedule.ts's findUnavailableCastId/
      // buildReservationSlotRefs, stripe-webhooks.ts's
      // handleAmountCapturableUpdated) resolves purely by that deterministic
      // ID, never by querying the cast_id field - so a colliding doc
      // permanently sabotaged the real cast's availability and could get a
      // real reservation auto-cancelled, with no self-remediation possible
      // for the victim (toggleScheduleSlot refuses to touch a "reserved"
      // slot). Tying the document ID itself to the caller's own uid closes
      // this: an attacker can no longer create anything at a path that
      // resolves to another cast's slot, regardless of what they set the
      // cast_id field to.
      allow create: if isSignedIn()
        && request.resource.data.cast_id == request.auth.uid
        && document.matches(request.auth.uid + '_[0-9]+');
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.cast_id == request.auth.uid);
    }

    // Tier-4 hardening (2026-07-31): admin action audit trail - written
    // exclusively by createAuditLog() in admin.ts via Admin SDK (bypasses
    // these rules entirely), read exclusively by the admin dashboard's
    // adminGetAuditLogs Cloud Function (also Admin SDK). No legitimate
    // direct client read or write of any kind.
    match /audit_logs/{document} {
      allow create: if false;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // Affiliate rate change history (アフィリエイト料率変更履歴) - written
    // exclusively by adminUpdateAffiliateRate via Admin SDK, read by the
    // admin affiliate rate-override UI. Found with no rule of its own at all
    // (schema pre-existed, unused) during the Phase 9 backend audit - same
    // lockdown as audit_logs since it is the same kind of admin-only,
    // server-written change log.
    match /affiliate_rate_history/{document} {
      allow create: if false;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // 2026-08-07: Stripe webhook idempotency ledger (§17.4 ⑮'s
    // "ProcessedEvents") - written exclusively by stripe-webhooks.ts via
    // Admin SDK (bypasses these rules entirely; this collection previously
    // had no rule of its own at all, matching audit_logs' explicit
    // lockdown now that adminGetProcessedEvents gives it a legitimate
    // admin-facing read path). No legitimate direct client read or write -
    // permanence is the whole point of this collection (no TTL is ever
    // set on it, unlike stripe_logs' own 90-day TTL), so client delete is
    // blocked outright same as audit_logs.
    match /processed_events/{document} {
      allow create: if false;
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

  }
}
