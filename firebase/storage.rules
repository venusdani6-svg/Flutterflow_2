rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    // Banner images are shown publicly in the app UI, so read is open like
    // the `banners` Firestore collection.
    //
    // FIX (comprehensive project-wide review round 2, confirmed live
    // vulnerability): write used to be gated to ANY signed-in user, not
    // just admins — a real exploit, not just disclosed debt (PROJECT_
    // KNOWLEDGE.md §18.36's "accepted" framing undersold it): any
    // authenticated non-admin could upload/overwrite arbitrary files under
    // the public `banners/` path via the Storage SDK directly, e.g.
    // defacing a live promotional banner by overwriting a known/guessed
    // file path. Fixed to mirror firestore.rules' own `isAdmin()` check
    // (users/{uid}.role == 'admin') via a cross-service `firestore.get()`
    // call — the same admin definition used everywhere else in this
    // project, not a separate one to keep in sync.
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // CocoTen venue photos (unimplemented-features pass, IMPLEMENTATION_
    // PLAN.md §3.8 item 7) — same public-read/admin-only-write shape as
    // banners above, for the same reason: shown publicly in the guest-
    // facing app UI (CocoTenDetailPage), uploaded only via
    // CocotenManagementPage's admin form.
    match /cocoten_shops/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // KYC documents + selfie (kyc.dart -> pickAndUploadImage custom action)
    // and any other per-user upload (profile photos, gallery images) — owner
    // read/write only. `kyc_doc_url`/`kyc_selfie_url` on the user's own
    // Firestore doc are openly readable by that same rule set already
    // (firestore.rules), so gating the underlying file to owner-only here is
    // the meaningful boundary — admin review of KYC docs goes through the
    // Admin SDK (server-side, bypasses these rules entirely), not a direct
    // client read.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
