{
  "name": "icoccha-functions",
  "version": "1.0.0",
  "description": "icoccha matching app Cloud Functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "typescript": "^5.3.0"
  },
  "private": true
}
